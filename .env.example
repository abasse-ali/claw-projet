# ============================================================
# Configuration du script d'automatisation e-commerce
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# --- Configuration du scraping (facultatif) ---
# URL du sitemap du site source
SOURCE_SITEMAP_URL=https://www.atelierdelafourmi.fr/sitemap.xml
# Timeout réseau en secondes pour les requêtes HTTP
REQUEST_TIMEOUT=30
# Nombre maximal de produits a scraper (0 = tous)
MAX_PRODUCTS=0

# --- Amazon SP-API ---
# Compte vendeur Amazon
AMAZON_SELLER_ID=
# Région AWS (eu-west-1 pour l'Europe)
AMAZON_AWS_REGION=eu-west-1
# Marketplace IDs (France = A13V1VB97FVB, Allemagne = A1PA6795UKMFR9, etc.)
AMAZON_MARKETPLACE_IDS=A13V1VB97FVB
# AWS credentials (créés via IAM)
AMAZON_AWS_ACCESS_KEY_ID=
AMAZON_AWS_SECRET_ACCESS_KEY=
# Login with Amazon (LWA)
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=
# Endpoint SP-API pour l'Europe
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
# Taxe applicable (code de la taxation Amazon)
AMAZON_TAX_CODE=

# --- CDiscount / Octopia API ---
# Identifiants API Octopia (obtenus via le compte vendeur CDiscount)
CDISCOUNT_CLIENT_ID=
CDISCOUNT_CLIENT_SECRET=
# Endpoint de l'API Octopia
CDISCOUNT_API_ENDPOINT=https://api.octopia-io.net
# ID du canal de vente (CDiscount France, etc.)
CDISCOUNT_SALES_CHANNEL=
